(require '[clojure.edn] '[kotoba.giemon.arm :as arm])
(def m (first (clojure.edn/read-string (slurp "fixtures/giemon_arm6/giemon_arm6.edn"))))
(def ch (clojure.edn/read-string (:arm/chain m)))
(defn set-j6-axis [ax] {:arm/chain (mapv #(if (= (:joint/name %) "j6") (assoc % :joint/axis ax) %) ch)})
(def ee (arm/end-effector (set-j6-axis [0 0 0]) [0 0 0 0 0 Math/PI]))
(defn det3 [R]
  (+ (- (* (nth (nth R 0) 0)
           (- (* (nth (nth R 1) 1) (nth (nth R 2) 2)) (* (nth (nth R 1) 2) (nth (nth R 2) 1))))
        (* (nth (nth R 0) 1)
           (- (* (nth (nth R 1) 0) (nth (nth R 2) 2)) (* (nth (nth R 1) 2) (nth (nth R 2) 0)))))
     (* (nth (nth R 0) 2)
        (- (* (nth (nth R 1) 0) (nth (nth R 2) 1)) (* (nth (nth R 1) 1) (nth (nth R 2) 0))))))
(println :zeroaxis-pi-rot-row2 (get-in ee [:xf/rot 2]))
(println :zeroaxis-pi-det (det3 (:xf/rot ee)))
(println :zeroaxis-pi-pos (:xf/pos ee))
(println :baseline-pi-det (det3 (:xf/rot (arm/end-effector {:arm/chain ch} [0 0 0 0 0 Math/PI]))))
(println :lim-inf-only-upper (arm/within-limits? {:joint/limit {:lower -3.0 :upper ##Inf}} 1e9))
(println :lim-neg-lower (arm/within-limits? {:joint/limit {:lower ##-Inf :upper 3.0}} -1e9))
